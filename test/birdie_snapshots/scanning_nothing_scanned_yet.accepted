<main class="mx-auto max-w-3xl space-y-4 p-6">
  <h1 class="text-2xl font-semibold">
    Scan your export
  </h1>
  <div class="[&amp;&gt;video]:w-full [&amp;&gt;video]:max-w-[520px] [&amp;&gt;video]:rounded-box [&amp;&gt;video]:bg-black" id="camera-preview"></div>
  <p>
